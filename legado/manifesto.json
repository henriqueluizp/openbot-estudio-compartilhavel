{
  "package": "openbot-estudio-conteudo",
  "version": "1.1.0",
  "language": "pt-BR",
  "kind": "declarative_specification",
  "native_openbot_import": false,
  "entrypoint": "PROMPT_INSTALACAO.md",
  "standalone_entrypoint": "PROMPT_UNICO_OPENBOT.txt",
  "configuration_template": "config/projeto.exemplo.json",
  "niche_example": "config/perfil-nicho.exemplo.json",
  "agents_registry_template": "modelos/AGENTES.exemplo.json",
  "install_report_template": "modelos/RELATORIO-INSTALACAO.md",
  "initial_state": {
    "project": "setup",
    "pilot_approved": false,
    "routine_active": false,
    "publication_authorized": false
  },
  "agents": [
    {
      "key": "coordenacao",
      "default_name": "Coordenação",
      "role": "Coordenação, pesquisa e roteiro",
      "prompt": "agentes/coordenacao.md",
      "queries": "sql/10_coordenacao.sql",
      "query_prefix": "CO",
      "capabilities": ["research", "writing", "coordination", "project_data"],
      "owns": ["BIBLIA.md", "FLUXO.md", "episodios/*/roteiro.md", "episodios/*/status.md", "publicacao/", "videos-prontos/"],
      "model": "choose_from_available_accounts"
    },
    {
      "key": "arte",
      "default_name": "Arte",
      "role": "Direção de arte e storyboard",
      "prompt": "agentes/arte.md",
      "queries": "sql/20_arte.sql",
      "query_prefix": "AR",
      "capabilities": ["visual_design", "vector_or_image_tools", "project_data"],
      "owns": ["personagens/", "cenarios/", "referencias/arte/", "episodios/*/storyboard.md", "episodios/*/storyboard/", "episodios/*/arte/"],
      "model": "choose_from_available_accounts"
    },
    {
      "key": "producao",
      "default_name": "Produção",
      "role": "Voz, animação, edição e master",
      "prompt": "agentes/producao.md",
      "queries": "sql/30_producao.sql",
      "query_prefix": "PR",
      "capabilities": ["coding", "audio_tools", "render_tools", "project_data"],
      "owns": ["estudio/", "episodios/*/audio/", "episodios/*/montagem.json", "episodios/*/final/", "episodios/*/contact.jpg", "episodios/*/producao.md"],
      "model": "choose_from_available_accounts"
    },
    {
      "key": "revisao",
      "default_name": "Revisão",
      "role": "Revisão independente de roteiro e vídeo",
      "prompt": "agentes/revisao.md",
      "queries": "sql/40_revisao.sql",
      "query_prefix": "RV",
      "capabilities": ["source_verification", "image_review", "audio_review", "project_data"],
      "owns": ["episodios/*/revisao-roteiro.md", "episodios/*/revisao-final.md", "modelos/checklist-revisao.md"],
      "model": "choose_from_available_accounts"
    }
  ],
  "pipeline": [
    {"step": "research_and_script", "owner": "coordenacao", "requires": ["setup_complete"]},
    {"step": "script_review", "owner": "revisao", "requires": ["research_and_script"]},
    {"step": "voice_and_timings", "owner": "producao", "requires": ["script_review_passed"]},
    {"step": "art_preparation", "owner": "arte", "requires": ["script_review_passed"]},
    {"step": "storyboard", "owner": "arte", "requires": ["voice_and_timings", "art_preparation"]},
    {"step": "render_and_master", "owner": "producao", "requires": ["storyboard"]},
    {"step": "final_review", "owner": "revisao", "requires": ["render_and_master"]},
    {"step": "delivery", "owner": "coordenacao", "requires": ["final_review_passed"]},
    {"step": "optional_publication", "owner": "configured_publisher", "requires": ["delivery", "valid_authorization", "confirmed_account"]}
  ],
  "directories": ["config", "instrucoes", "modelos", "fontes", "temas", "referencias", "personagens", "cenarios", "estudio", "episodios", "publicacao", "videos-prontos", "relatorios"],
  "shared_sql": ["sql/05_fontes.sql", "sql/50_custos.sql", "sql/60_publicacao.sql", "sql/70_bloqueios.sql"],
  "schema": "sql/00_schema.sql",
  "administrative_sql": "sql/90_setup_e_estado.sql",
  "routine_prompt": "rotinas/fabrica.md",
  "studio_requirements": "estudio/REQUISITOS.md",
  "validation_guide": "docs/validacao.md",
  "includes_media_or_credentials": false
}
